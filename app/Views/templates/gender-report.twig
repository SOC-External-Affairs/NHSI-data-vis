<div class="wrap">
    <h1>{{ page_title }}</h1>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {% include 'report-styles.twig' %}

    <div class="postbox">
        <div class="inside">
            <div class="dual-donut-container">
                <div class="donut-chart">
                    <h2>Gender</h2>
                    {% if gender_data %}
                        <canvas id="genderChart"></canvas>
                        <table class="wp-list-table widefat striped">
                            <tbody>
                                {% for item in gender_data %}
                                    <tr>
                                        <td>{{ item.gender }}</td>
                                        <td><strong>{{ item.count }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>No gender data available.</p>
                    {% endif %}
                </div>
                <div class="donut-chart">
                    <h2>Pronouns</h2>
                    {% if pronouns_data %}
                        <canvas id="pronounsChart"></canvas>
                        <table class="wp-list-table widefat striped">
                            <tbody>
                                {% for item in pronouns_data %}
                                    <tr>
                                        <td>{{ item.pronouns }}</td>
                                        <td><strong>{{ item.count }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>No pronouns data available.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.dual-donut-container {
    display: flex;
    gap: 40px;
    justify-content: center;
    flex-wrap: wrap;
}
.donut-chart {
    flex: 1;
    min-width: 300px;
    max-width: 450px;
    text-align: center;
}
.donut-chart h2 {
    margin-bottom: 15px;
    font-size: 1.2em;
    color: #333;
}
.donut-chart canvas {
    max-height: 280px;
    margin-bottom: 15px;
}
.donut-chart table {
    font-size: 0.9em;
}
</style>

<script>
{% if gender_data %}
new Chart(document.getElementById('genderChart'), {
    type: 'doughnut',
    data: {
        labels: [{% for item in gender_data %}'{{ item.gender|e }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            data: [{% for item in gender_data %}{{ item.count }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: ['#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#C9CBCF'],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: { 
        responsive: true, 
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'bottom' }
        }
    }
});
{% endif %}

{% if pronouns_data %}
new Chart(document.getElementById('pronounsChart'), {
    type: 'doughnut',
    data: {
        labels: [{% for item in pronouns_data %}'{{ item.pronouns|e }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            data: [{% for item in pronouns_data %}{{ item.count }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0', '#9966FF', '#FF9F40', '#C9CBCF'],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: { 
        responsive: true, 
        maintainAspectRatio: false,
        plugins: {
            legend: { position: 'bottom' }
        }
    }
});
{% endif %}
</script>
