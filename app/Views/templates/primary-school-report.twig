<div class="wrap">
    <h1>{{ page_title }}</h1>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {% include 'report-styles.twig' %}

    <div class="postbox">
        <div class="inside">
            {% if data %}
                <div class="chart-container" style="height: 500px;">
                    <canvas id="primarySchoolChart"></canvas>
                </div>
                <table class="wp-list-table widefat striped">
                    <thead>
                        <tr>
                            <th>Primary School</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for school in data %}
                            <tr>
                                <td>{{ school.primary_school }}</td>
                                <td><strong>{{ school.count }}</strong></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <p>No primary school data available.</p>
            {% endif %}
        </div>
    </div>
</div>

<script>
{% if data %}
new Chart(document.getElementById('primarySchoolChart'), {
    type: 'bar',
    data: {
        labels: [{% for school in data %}'{{ school.primary_school|e }}'{% if not loop.last %},{% endif %}{% endfor %}],
        datasets: [{
            label: 'Students',
            data: [{% for school in data %}{{ school.count }}{% if not loop.last %},{% endif %}{% endfor %}],
            backgroundColor: '#36A2EB',
            borderColor: '#2484c6',
            borderWidth: 1
        }]
    },
    options: {
        indexAxis: 'y',
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false }
        }
    }
});
{% endif %}
</script>
